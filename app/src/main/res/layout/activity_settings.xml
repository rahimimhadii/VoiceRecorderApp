<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_gradient">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/format" android:textAppearance="?attr/textAppearanceTitleMedium" />
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/formatGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton android:id="@+id/m4aButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/format_m4a" />
        <com.google.android.material.button.MaterialButton android:id="@+id/wavButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/format_wav" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/minutesLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:hint="@string/automatic_stop">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/minutesInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/hoursLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/safety_limit">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/hoursInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="28dp" android:text="@string/save" app:cornerRadius="18dp" />
</LinearLayout>
